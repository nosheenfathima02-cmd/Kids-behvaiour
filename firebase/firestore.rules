rules_version = '2';

// Super Mom security rules.
//
// Who is who:
//  * Parents sign in with Google, Apple or email. Their uid is in families/{fid}.parents.
//  * A child's device signs in anonymously and is linked to a family by a QR
//    code. Its families/{fid}/devices/{uid} document lists the kids it may act for.
//
// Children may only tick or untick their own tasks, today, while the task's
// time window is open. Everything else is for parents only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isRealAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function familyDoc(fid) {
      return get(/databases/$(database)/documents/families/$(fid)).data;
    }

    function isParent(fid) {
      return isRealAccount() && request.auth.uid in familyDoc(fid).parents;
    }

    function devicePath(fid) {
      return /databases/$(database)/documents/families/$(fid)/devices/$(request.auth.uid);
    }

    function isDevice(fid) {
      return signedIn() && exists(devicePath(fid));
    }

    function deviceFor(fid, kidId) {
      return isDevice(fid) && kidId in get(devicePath(fid)).data.kidIds;
    }

    // Current time in the family's time zone (the parent's phone keeps tzOffsetMin up to date).
    function localNow(fid) {
      return request.time + duration.value(familyDoc(fid).tzOffsetMin, 'm');
    }

    function ymd(t) {
      return string(t.year() * 10000 + t.month() * 100 + t.day());
    }

    // The school week is named after its Monday, e.g. "20261019".
    function currentWeekId(t) {
      return ymd(t - duration.value(t.dayOfWeek() - 1, 'd'));
    }

    // A tick that reaches the server shortly after the window closed (slow
    // network) is still accepted. The app itself locks the task on time.
    function graceMinutes() {
      return 60;
    }

    function prayerWindowOk(fam, prayer, dateKey, minute) {
      let i = {'fajr': 0, 'dhuhr': 2, 'asr': 4, 'maghrib': 6, 'isha': 8}[prayer];
      let windows = fam.get('prayerWindows', {});
      // Windows are written ahead by the parent's app. If they are missing,
      // fall back to "today only".
      return !(dateKey in windows) || (
        minute >= windows[dateKey][i] && minute <= windows[dateKey][i + 1] + graceMinutes()
      );
    }

    // key looks like "3:homework" (weekday 3 = Wednesday). The task is either
    // part of the weekly routine, or a school item (homework, test revision,
    // competition practice) whose id starts with "s_".
    function kidMayChange(fid, kidId, key) {
      let fam = familyDoc(fid);
      let t = localNow(fid);
      let parts = key.split(':');
      let minute = t.hours() * 60 + t.minutes();
      return parts.size() == 2
        && parts[0] == string(t.dayOfWeek())
        && (routineTaskOk(fam, kidId, parts[1], t, minute) || schoolTaskOk(fam, kidId, parts[1], t, minute));
    }

    function routineTaskOk(fam, kidId, taskId, t, minute) {
      return taskId in fam.routine && routineWindowOk(fam, fam.routine[taskId], kidId, t, minute);
    }

    function routineWindowOk(fam, task, kidId, t, minute) {
      return t.dayOfWeek() in task.weekdays
        && (task.get('kidIds', null) == null || kidId in task.kidIds)
        && (
          (task.get('prayer', null) == null && minute >= task.startMin && minute <= task.endMin + graceMinutes())
          || (task.get('prayer', null) != null && prayerWindowOk(fam, task.prayer, ymd(t), minute))
        );
    }

    function schoolTaskOk(fam, kidId, taskId, t, minute) {
      return taskId in fam.get('schoolItems', {}) && schoolWindowOk(fam.schoolItems[taskId], kidId, t, minute);
    }

    // On a school day between fromYmd and toYmd, inside the item's time window.
    function schoolWindowOk(item, kidId, t, minute) {
      return item.kidId == kidId
        && item.get('fromYmd', null) is string
        && item.get('toYmd', null) is string
        && ymd(t) >= item.fromYmd
        && ymd(t) <= item.toYmd
        && t.dayOfWeek() <= 5
        && minute >= item.startMin
        && minute <= item.endMin + graceMinutes();
    }

    // One tick added (value "kid") or one of the child's own ticks removed.
    // Ticks Mom made cannot be changed by the child.
    function checksChangeOk(fid, kidId, before, after, key) {
      let diff = after.diff(before);
      return diff.affectedKeys().size() == 0 || (
        diff.affectedKeys() == [key].toSet()
        && kidMayChange(fid, kidId, key)
        && (
          (diff.addedKeys() == [key].toSet() && after[key] == 'kid')
          || (diff.removedKeys() == [key].toSet() && before[key] == 'kid')
        )
      );
    }

    function wishOk(fid, kidId, before, after) {
      return after.get('wishIndex', null) == before.get('wishIndex', null)
        || after.wishIndex == null
        || (after.wishIndex is int && after.wishIndex >= 0
            && after.wishIndex < get(/databases/$(database)/documents/families/$(fid)/kids/$(kidId)).data.rewards.size());
    }

    // ---------- families ----------

    match /families/{fid} {
      allow get: if isParent(fid) || isDevice(fid);
      allow list: if isRealAccount() && request.auth.uid in resource.data.parents;
      allow create: if isRealAccount() && request.resource.data.parents == [request.auth.uid];
      allow update: if isParent(fid) && request.auth.uid in request.resource.data.parents;
      allow delete: if isParent(fid);

      match /kids/{kidId} {
        allow get: if isParent(fid) || deviceFor(fid, kidId);
        allow list, write: if isParent(fid);
      }

      // One document per child per week, id "<weekId>_<kidId>".
      match /weeks/{wid} {
        allow get: if isParent(fid) || deviceFor(fid, wid.split('_')[1]);
        allow list, delete: if isParent(fid);

        allow create: if isParent(fid) || (
          deviceFor(fid, request.resource.data.kidId)
          && request.resource.data.keys().hasOnly(['kidId', 'weekId', 'checks', 'lastChange'])
          && request.resource.data.weekId == currentWeekId(localNow(fid))
          && wid == request.resource.data.weekId + '_' + request.resource.data.kidId
          && request.resource.data.checks.keys() == [request.resource.data.lastChange]
          && checksChangeOk(fid, request.resource.data.kidId, {}, request.resource.data.checks, request.resource.data.lastChange)
        );

        allow update: if isParent(fid) || (
          deviceFor(fid, resource.data.kidId)
          && resource.data.weekId == currentWeekId(localNow(fid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checks', 'wishIndex', 'lastChange'])
          && checksChangeOk(fid, resource.data.kidId, resource.data.get('checks', {}),
                            request.resource.data.get('checks', {}), request.resource.data.get('lastChange', ''))
          && wishOk(fid, resource.data.kidId, resource.data, request.resource.data)
        );
      }

      // Linked children's devices. A device can see and remove its own link.
      match /devices/{uid} {
        allow get, delete: if isParent(fid) || (signedIn() && request.auth.uid == uid);
        allow list: if isParent(fid);
        allow update: if isParent(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'kidIds']);
        allow create: if signedIn() && request.auth.uid == uid && pairingOk(fid);
      }

      // Push notification tokens for the parents' phones.
      match /parentTokens/{token} {
        allow read, write: if isParent(fid);
      }
    }

    // ---------- linking a child's device ----------

    // The new device must use a valid, unexpired code for this family, and
    // delete the code in the same write so it works only once.
    function pairingOk(fid) {
      let code = request.resource.data.pairCode;
      let p = get(/databases/$(database)/documents/pairings/$(code)).data;
      return p.familyId == fid
        && p.kidIds == request.resource.data.kidIds
        && p.expiresAt > request.time
        && !existsAfter(/databases/$(database)/documents/pairings/$(code))
        && request.resource.data.keys().hasOnly(['kidIds', 'name', 'pairCode', 'pairedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
    }

    match /pairings/{code} {
      // Only by exact code; anyone else's codes cannot be listed.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if code.size() >= 8
        && request.resource.data.createdBy == request.auth.uid
        && isParent(request.resource.data.familyId)
        && request.resource.data.kidIds is list
        && request.resource.data.kidIds.size() > 0
        && request.resource.data.expiresAt < request.time + duration.value(15, 'm');
      allow delete: if (signedIn() && resource.data.createdBy == request.auth.uid)
        || (signedIn() && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/devices/$(request.auth.uid)).data.pairCode == code);
    }
  }
}
